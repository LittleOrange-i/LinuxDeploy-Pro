<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 预留权限：后续与 CLI 联调、网络下载发行版镜像时使用 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_SUPERUSER" />
    <!-- 长任务保活前台服务（部署/导出期间防进程回收与锁屏挂起） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 容器常驻保活前台服务（specialUse 类型不受 dataSync 6 小时/24h 限制，
         且允许 BOOT_COMPLETED 拉起；容器运行期间息屏不掉线） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- WifiLock：息屏后阻止 WiFi 休眠（容器网络保持可用） -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- 电池优化白名单：深度休眠（Doze）下系统忽略非白名单应用的 WakeLock，
         引导用户豁免后息屏保活才可靠 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
    allowBackup=false：容器配置含明文密码（CLI 需明文才能写容器 /etc/passwd），
    禁止系统备份带出；重装运行环境功能可重建一切。
    usesCleartextTraffic 未开启：App 自身无网络请求（下载全部由 CLI 子进程的
    wget 完成，不受 Android 网络策略约束），无需放行明文 HTTP。
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinuxDeployPro">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 容器常驻保活：容器运行期间持有 WakeLock/WifiLock，息屏不掉线。
             specialUse 需声明 PROPERTY_SPECIAL_USE_FGS_SUBTYPE 说明用途 -->
        <service
            android:name=".data.ContainerKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="linux_chroot_container_keepalive：容器（chroot）运行期间保持 CPU 唤醒与 WiFi 可用，息屏后 SSH 等服务不中断" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
